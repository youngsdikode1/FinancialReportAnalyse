# ---------------- 内存临时对象 CPDFPage 只内存，不落地 ----------------
class CPDFPage:
    def __init__(self, page_num: int, content: str):
        self.m_page_num: int = page_num
        self.m_content: str = content

# ---------------- 内存对象：单批次摘要记录 ----------------
class CBatchSummary:
    def __init__(self, start_page: int, end_page: int, content: str):
        self.m_start_page: int = start_page
        self.m_end_page: int = end_page
        self.m_content: str = content

# ===================== 单层扁平schema（来自demo ReportSimpleOut，移除全部嵌套与数组） =====================
class ReportSimpleOut(BaseModel):
    stock_code: str | None = Field(description="股票代码，识别不到返回null")
    company_name: str | None = Field(description="公司完整全称，识别不到返回null")
    company_desc: str | None = Field(description="简短公司业务简介，一百多字，识别不到返回null")
    report_type: str | None = Field(description="只能取：年报|中报|第一季度报告|第三季度报告，识别不到填null")
    report_year: int | None = Field(description="4位数字报告年份，识别不到填null")
    report_quarter: int | None = Field(description="取值 0|1|3；年报填0，一季报1，三季报3，中报填null；识别不到填null")
    report_markdown: str | None = Field(description="完整markdown格式财报研读报告，按章节组织，关键信息带上【来源页码：N】")

# ---------------- LLM结构化Schema（分批摘要保留不变） ----------------
class CBatchFullMetaOutput(BaseModel):
    company_short_name: Optional[str] = Field(default=None, description="公司简称，识别不出填null")
    stock_code: Optional[str] = Field(default=None, description="A股股票代码6位字符串，识别不出填null")
    company_full_name: Optional[str] = Field(default=None, description="上市公司完整全称，识别不出填null")
    company_desc: Optional[str] = Field(default=None, description="公司简短业务简介，识别不出填null")
    report_type: Optional[str] = Field(default=None, description="年报/中报/第一季度报告/第三季度报告，识别不出填null")
    report_year: Optional[int] = Field(default=None, description="报告4位年份，识别不出填null")
    quarter: Optional[int] = Field(default=0, description="0/1/3，年报中报0，一季报1，三季报3")
    batch_summary: str = Field(description="本批次页面内容摘要，不能为空")

# 全部批次汇总之后全局输出
class CGlobalSummaryOutput(BaseModel):
    full_report_summary: str = Field(description="财报整体综合摘要")
    akshare_style_text: str = Field(description="模仿akshare_demo输出的纯文本财务数据，不要markdown表格，纯文本")

# ---------------- Agent State ----------------
class CPdfProcessorState(TypedDict):
    pdf_path: str
    force_overwrite: bool
    dump_batch_summary: bool
    # 解析产物
    page_list: Optional[List[CPDFPage]]
    total_page_count: int
    # 分批摘要中间产物 【新增report_type report_year用于增量收集元信息】
    has_got_meta: bool
    company_short_name: Optional[str]
    stock_code: Optional[str]
    company_full_name: Optional[str]
    company_desc: Optional[str]
    report_type: Optional[str]
    report_year: Optional[int]
    report_date: Optional[CReportDate]
    batch_summary_list: List[CBatchSummary]
    # 目录
    report_dir: Optional[str]
    # 全局汇总输出
    full_report_summary: Optional[str]
    akshare_style_text: Optional[str]
    # 拼接完整raw文本
    raw_full_text: Optional[str]
    # 返回状态
    success: bool
    is_skip: bool
    fail_msg: Optional[str]


class CAgentPDFProcessor:
    def __init__(self):
        self.m_graph = self._build_graph()

    def _build_graph(self):
        gb = StateGraph(CPdfProcessorState)
        gb.add_node("NodeCheckFile", self._node_check_file)
        gb.add_node("NodeParsePdf", self._node_parse_pdf)
        gb.add_node("NodeBatchSummarizeLoop", self._node_batch_summarize_loop)
        gb.add_node("NodeCheckReportDirExist", self._node_check_report_dir_exist)
        gb.add_node("NodeGlobalSummary", self._node_global_summary)
        gb.add_node("NodeBuildRawTextAndWrite", self._node_build_raw_and_write)
        gb.add_node("NodeBuildReportEntity", self._node_build_report_entity)
        gb.add_node("NodeMockRagIngest", self._node_mock_rag_ingest)
        gb.add_node("NodeFinish", self._node_finish)
        gb.set_entry_point("NodeCheckFile")

        # 文件校验失败直接结束
        def _route_after_check_file(state: CPdfProcessorState):
            if not state["success"]:
                return "NodeFinish"
            return "NodeParsePdf"
        gb.add_conditional_edges("NodeCheckFile", _route_after_check_file)

        # PDF解析失败直接结束
        def _route_after_parse_pdf(state: CPdfProcessorState):
            if not state["success"]:
                return "NodeFinish"
            return "NodeBatchSummarizeLoop"
        gb.add_conditional_edges("NodeParsePdf", _route_after_parse_pdf)

        # 分批摘要识别元信息失败直接结束
        def _route_after_batch_loop(state: CPdfProcessorState):
            if not state["success"]:
                return "NodeFinish"
            return "NodeCheckReportDirExist"
        gb.add_conditional_edges("NodeBatchSummarizeLoop", _route_after_batch_loop)

        gb.add_edge("NodeCheckReportDirExist", "NodeGlobalSummary")
        gb.add_edge("NodeGlobalSummary", "NodeBuildRawTextAndWrite")
        gb.add_edge("NodeBuildRawTextAndWrite", "NodeBuildReportEntity")
        gb.add_edge("NodeBuildReportEntity", "NodeMockRagIngest")
        gb.add_edge("NodeMockRagIngest", "NodeFinish")
        return gb.compile()

    def _WriteMeta(self, state, batch_out):
        """增量回填元信息：state字段为None才写入，已有值绝不覆盖；集齐关键字段自动开启has_got_meta"""
        if state["company_short_name"] is None and batch_out.company_short_name is not None:
            state["company_short_name"] = batch_out.company_short_name
        if state["stock_code"] is None and batch_out.stock_code is not None:
            state["stock_code"] = batch_out.stock_code
        if state["company_full_name"] is None and batch_out.company_full_name is not None:
            state["company_full_name"] = batch_out.company_full_name
        if state["company_desc"] is None and batch_out.company_desc is not None:
            state["company_desc"] = batch_out.company_desc
        if state["report_type"] is None and batch_out.report_type is not None:
            state["report_type"] = batch_out.report_type
        if state["report_year"] is None and batch_out.report_year is not None:
            state["report_year"] = batch_out.report_year

        rt = state["report_type"]
        ry = state["report_year"]
        rd = None
        if rt is not None and ry is not None:
            if rt in ("年报", "年度报告", "第四季度报告", "4季度报告"):
                rd = CReportDate(TYPE_ANNUAL, year=ry, quarter=0)
            elif rt in ("中报", "半年度报告"):
                rd = CReportDate(TYPE_HALF, year=ry, quarter=0)
            elif rt == "第一季度报告":
                rd = CReportDate(TYPE_QUARTER, year=ry, quarter=1)
            elif rt == "第三季度报告":
                rd = CReportDate(TYPE_QUARTER, year=ry, quarter=3)
        if rd is not None:
            state["report_date"] = rd

        need_fields = [
            state["stock_code"],
            state["company_full_name"],
            state["report_type"],
            state["report_year"]
        ]
        all_ready = all(x is not None for x in need_fields)
        if all_ready:
            state["has_got_meta"] = True
            LogInfo(f"_WriteMeta 全部元信息集齐 has_got_meta=True, rd={state.get('report_date')}")
        else:
            LogInfo(f"_WriteMeta 尚未集齐完整元信息, stock={state['stock_code']},full={state['company_full_name']},rt={state['report_type']},ry={state['report_year']}")

    def FetchPagesSummary(self, overlap_keep, page_text_block):
        prompt = f"""
你是财报分批摘要助手。
下面是一批财报页面文本。
【重要说明】这批内容开头的{overlap_keep}页是上一批的重叠上下文，仅用于理解上下文，不要把这部分内容重复写入batch_summary。
【强制规则】
0. JSON实体字段最高优先级！stock_code、company_full_name、report_type、report_year 这几个字段尽量输出有效值。
1. 本任务为【信息抽取式摘要】，严禁过度压缩；
需要尽量保留：管理层讨论、各业务板块情况、重要会计科目变动、重大事项、风险提示、关联交易、分红、研发投入、社会责任等章节的关键要点；
禁止把多个不同章节合并成一句笼统概括。
2. 摘要总结控制在800-1000字左右，不要过少也不要过多；
若本批次以目录/页眉页脚为主，有效文字极少，则不受此比例约束，输出对应说明即可。
3. 严禁空洞套话：禁止写"本报告涵盖xxx、xxx内容"这类没有实质信息的句子；
- 如果本窗口只有目录、页眉页脚、格式文本，没有新增有效业务财务信息，请如实写："本部分为目录/页眉页脚，无新增有效业务财务信息"。
4. 所有数字严格来源于当前页面文本，严禁脑补、编造财务数据。
5. report_type约束：只允许输出4个固定字符串："年报","中报","第一季度报告","第三季度报告"；
A股没有独立第四季度报告，四季度数据合并在年报中，如果识别到第四季度内容，请输出"年报"；
禁止输出"年度报告"、"半年度报告"、"第四季度报告"这类别名。
【JSON输出说明】
- 如果还未识别出公司及财报元信息：请严谨准确填充全部实体字段；
- 如果公司、报告元信息已经识别完成（你无法感知程序内部状态），依旧输出正确对应的实体取值，不要填写无效或空值；
注意：程序在内部已经锁定元信息，不会采用本批次返回的实体字段，仅batch_summary摘要会被业务使用。
请识别：公司简称、股票代码、公司全称、公司简介、报告类型、报告年份、季度，同时输出本批次内容摘要。
"""
        full_prompt = prompt + "\n====页面文本====\n" + page_text_block
        llm = CLLMRequest()
        llm.SWitchToHeavyModel()
        batch_out: CBatchFullMetaOutput = llm.InvokeStructured(full_prompt, CBatchFullMetaOutput)
        return batch_out

    def FetchWholeReportSummary(self, full_report_text: str) -> ReportSimpleOut:
        """
        参考demo test_report_langchain_structured实现
        使用单层扁平ReportSimpleOut，无嵌套无数组；完整研读全部放入report_markdown
        【兼容旧版CLLMRequest.InvokeStructured仅接收字符串prompt，不支持messages数组】
        """
        user_full_content = f"""
下面是一份完整的A股上市公司财报原始提取文本：
====完整财报全部文本====
{full_report_text}

任务说明：
解析这份财报，提取信息输出结构化对象。
字段说明：
1. stock_code：股票代码；识别不到填null
2. company_name：公司完整全称；识别不到填null
3. company_desc：简短公司业务简介，一百多字；识别不到填null
4. report_type：报告类型，只允许取值【年报|中报|第一季度报告|第三季度报告】，识别不到填null
5. report_year：4位数字报告年份；识别不到填null
6. report_quarter：季度标识，年报填0，一季报填1，三季报填3，中报填null；识别不到填null
7. report_markdown：完整markdown格式财报研读报告，按章节组织，关键信息带上【来源页码：N】。

【财报研读质量要求】（必须全部遵守）
1. 用markdown分章节输出，优先按财报原生章节组织；
2. 覆盖：公司概况、经营业绩、分产品/分地区业务、成本费用、资产负债、现金流、分红、重大事项、风险提示、审计意见；
3. 关键数字标注【来源页码：N】（文本里 `------------ grewtrewsfdg--页码号 N 页码号--grewtrewsfdg ---------------` 是页码分隔标记）；
4. 所有数字必须来自原文，禁止编造；指标冲突要标⚠️数据冲突；区分不同统计口径；
5. 输出字数尽量控制在5000‑7000token之间，禁止过度简略压缩，在限额内尽可能详实展开，不要省略业务说明、口径备注，不要只罗列表格数字。

文档使用固定标记分割PDF物理页码：
`------------ grewtrewsfdg--页码号 N 页码号--grewtrewsfdg ---------------`
N = PDF物理页码。
"""
        # =========兼容旧接口：拼接为单字符串prompt，不传入messages数组=========
        sys_content = "你是A股专业财报分析师，根据财报内容提取信息输出结构化对象。"
        full_prompt = f"【System】\n{sys_content}\n\n【User】\n{user_full_content}"

        llm = CLLMRequest()
        llm.SWitchToDeepseekModel()
        result: ReportSimpleOut = llm.InvokeStructured(full_prompt, ReportSimpleOut)
        if result is None:
            raise ValueError("FetchWholeReportSummary: InvokeStructured 返回None，tool‑choice解析失败")
        return result

    def _node_check_file(self, state: CPdfProcessorState) -> CPdfProcessorState:
        p = Path(state["pdf_path"])
        if not p.exists():
            failed_reason = f"文件不存在:{state['pdf_path']}"
            LogInfo(failed_reason)
            return {**state, "success": False, "fail_msg": failed_reason}
        if p.suffix.lower() != ".pdf":
            failed_reason = "不是pdf后缀文件"
            LogInfo(failed_reason)
            return {**state, "success": False, "fail_msg": failed_reason}
        LogInfo(f"[CAgentPDFProcessor] 文件校验通过 {p}")
        return state

    def _node_parse_pdf(self, state: CPdfProcessorState) -> CPdfProcessorState:
        pdf_p = Path(state["pdf_path"])
        page_list: List[CPDFPage] = []
        page_list.append(CPDFPage(page_num=0, content=""))
        try:
            count = 0
            with pdfplumber.open(pdf_p) as pdf:
                total = len(pdf.pages)
                for idx, page in enumerate(pdf.pages, start=1):
                    txt = page.extract_text() or ""
                    page_list.append(CPDFPage(page_num=idx, content=txt))
                    count += 1
                    if count % 10 == 0:
                        PrintLog(f"[CAgentPDFProcessor] PDF 已处理页数 {count}")
            LogInfo(f"[CAgentPDFProcessor] PDF解析完成，总页数 {total}")
            return {
                **state,
                "page_list": page_list,
                "total_page_count": total,
            }
        except Exception as e:
            LogInfo(f"[CAgentPDFProcessor] pdf解析异常 {e}")
            return {**state, "success": False, "fail_msg": f"pdf解析失败:{str(e)}"}

    def _node_batch_summarize_loop(self, state: CPdfProcessorState) -> CPdfProcessorState:
        page_list = state["page_list"]
        total_page = state["total_page_count"]
        batch_summary_list: List[CBatchSummary] = []
        batch_main = 20
        overlap_keep = 2
        ptr = 1
        prev_overlap_pages: List[CPDFPage] = []
        while ptr <= total_page:
            current_start = ptr
            take_main_end = ptr + batch_main - 1
            if take_main_end > total_page:
                take_main_end = total_page
            current_batch_pages: List[CPDFPage] = []
            current_batch_pages.extend(prev_overlap_pages)
            LogInfo(f"_node_batch_summarize_loop 正在处理 {current_start}页‑{take_main_end}页")
            PrintLog(f"_node_batch_summarize_loop 正在处理 {current_start}页‑{take_main_end}页")
            for pn in range(ptr, take_main_end + 1):
                current_batch_pages.append(page_list[pn])
            prev_overlap_pages = current_batch_pages[-overlap_keep:] if len(current_batch_pages) >= overlap_keep else current_batch_pages[:]
            ptr = take_main_end + 1
            page_text_block = ""
            for pg in current_batch_pages:
                page_text_block += f"---PAGE {pg.m_page_num}---\n{pg.m_content}\n"
            batch_out: CBatchFullMetaOutput = self.FetchPagesSummary(overlap_keep, page_text_block)
            self._WriteMeta(state, batch_out)
            batch_summary_list.append(CBatchSummary(
                start_page=current_start,
                end_page=take_main_end,
                content=batch_out.batch_summary
            ))
        state["batch_summary_list"] = batch_summary_list
        LogInfo(f"[CAgentPDFProcessor] 分批摘要完成，总批次 {len(batch_summary_list)}, has_got_meta={state['has_got_meta']}")
        if not state["has_got_meta"] or state.get("report_date") is None:
            msg = "全部页面处理完毕，未能识别出完整公司及财报元信息，该PDF大概率不是A股定期财报"
            LogInfo(f"[CAgentPDFProcessor] {msg}")
            return {**state, "success": False, "fail_msg": msg}
        return state

    def _node_check_report_dir_exist(self, state: CPdfProcessorState) -> CPdfProcessorState:
        stock_code = state["stock_code"]
        comp_dict = {
            "name": state["company_short_name"],
            "stock_code": stock_code,
            "fullname": state["company_full_name"],
            "desc": state["company_desc"]
        }
        comp_mgr = CCompanyManager.GetInstance()
        comp_mgr.CreateCompany(comp_dict)
        comp = comp_mgr.GetCompany(stock_code)
        rd: CReportDate = state["report_date"]
        rep_tmp = CFinancialReport(stock_code=stock_code, company_name=comp.m_name, report_date=rd)
        report_dir = rep_tmp.GetReportDir()
        state["report_dir"] = report_dir
        p_dir = Path(report_dir)
        force_overwrite = state["force_overwrite"]
        report_exist_in_memory = False
        if comp is not None:
            exist_rep = comp.m_report_manager.GetReport(rd)
            if exist_rep is not None:
                report_exist_in_memory = True
        disk_dir_exist = p_dir.exists()
        need_skip = (report_exist_in_memory or disk_dir_exist) and (not force_overwrite)
        if need_skip:
            LogInfo(f"[CAgentPDFProcessor] skip触发：内存存在报告={report_exist_in_memory}；磁盘目录存在={disk_dir_exist}；force_overwrite={force_overwrite}，跳过全部后续处理 {report_dir}")
            return {
                **state,
                "success": True,
                "is_skip": True,
                "fail_msg": "报告已存在(内存或磁盘)，未开启强制覆盖，跳过处理"
            }
        return state

    def _node_global_summary(self, state: CPdfProcessorState) -> CPdfProcessorState:
        batch_sum_text = "\n".join([bs.m_content for bs in state["batch_summary_list"]])
        prompt = f"""
你是财报汇总排版助手。
输入是多段财报分批抽取摘要文本。
【重要硬性铁律】
1、本任务**不是重新写一份简短财报摘要，禁止深度压缩提炼**！
允许做的工作：消除多段输入之间的完全重复、重叠内容，语句润色、段落重组排版；
2、尽量完整保留输入中出现的财务数字、业务事实、关键事件要点；不要为了缩短篇幅随意删减有效信息；
3、只剔除完全一模一样的重复文本，禁止主动删减有效业务与财务信息；
4、禁止改写原始业务事实，仅做去重与排版润色。
5、冲突数据处理规则：
   - 若同一个财务指标出现多组冲突金额/百分比，优先采信报告开篇【主要会计数据】口径；
   - 不要静默丢弃冲突数据；存在冲突时增加显式标记【⚠️分片提取存在冲突数据：xxx】；
   - 严格区分金额（元/亿元/万元）与百分比，严禁把ROE、增长率百分比当成利润金额；
   - 留意数字的千位逗号格式，修正错乱的逗号分隔，万元、亿元单位不要发生错位。
6、如费用化研发投入、总研发投入属于不同统计口径，两个口径都需要保留，加以文字说明口径差异，不要只保留其中一个。
输出两份结果：
1. full_report_summary：润色合并后的完整财报综合文本，保留全部关键信息，使用markdown分章节排版。
2. akshare_style_text：模仿akshare_demo样例输出纯文本财务数据，不要markdown表格，纯文本，每条一行。
分段摘要集合：
{batch_sum_text}
"""
        llm = CLLMRequest()
        llm.SWitchToHeavyModel()
        global_out: CGlobalSummaryOutput = llm.InvokeStructured(prompt, CGlobalSummaryOutput)
        LogInfo("[CAgentPDFProcessor] 全局汇总完成")
        return {
            **state,
            "full_report_summary": global_out.full_report_summary,
            "akshare_style_text": global_out.akshare_style_text
        }

    def _node_build_raw_and_write(self, state: CPdfProcessorState) -> CPdfProcessorState:
        page_list = state["page_list"]
        raw_lines = []
        for idx in range(1, len(page_list)):
            pg = page_list[idx]
            sep = f"------------ grewtrewsfdg--页码号 {pg.m_page_num} 页码号--grewtrewsfdg ---------------"
            raw_lines.append(sep)
            raw_lines.append(pg.m_content)
        raw_full_text = "\n".join(raw_lines)
        state["raw_full_text"] = raw_full_text
        report_dir = state["report_dir"]
        p_dir = Path(report_dir)
        p_dir.mkdir(parents=True, exist_ok=True)
        raw_txt_p = p_dir / "raw.txt"
        akshare_txt_p = p_dir / "akshare.txt"
        raw_txt_p.write_text(raw_full_text, encoding="utf‑8")
        akshare_txt_p.write_text(state["akshare_style_text"], encoding="utf‑8")
        if state["dump_batch_summary"]:
            sl_lines = []
            for bs in state["batch_summary_list"]:
                sep = f"------------ grewtrewsfdg--起始页{bs.m_start_page} 到 结束页{bs.m_end_page} 的总结 --grewtrewsfdg ---------------"
                sl_lines.append(sep)
                sl_lines.append(bs.m_content)
            sl_full = "\n".join(sl_lines)
            sl_path = p_dir / "summary_list.txt"
            sl_path.write_text(sl_full, encoding="utf‑8")
            LogInfo(f"[CAgentPDFProcessor] 调试输出summary_list.txt -> {sl_path}")
        LogInfo(f"[CAgentPDFProcessor] 写入raw.txt akshare.txt -> {report_dir}")
        return state

    def _node_build_report_entity(self, state: CPdfProcessorState) -> CPdfProcessorState:
        comp_mgr = CCompanyManager.GetInstance()
        comp = comp_mgr.GetByStockCode(state["stock_code"])
        rd: CReportDate = state["report_date"]
        rep = CFinancialReport(stock_code=state["stock_code"], company_name=comp.m_name, report_date=rd)
        rep.m_raw_pdf_text = state["raw_full_text"]
        rep.m_akshare = state["akshare_style_text"]
        rep.m_summary = state["full_report_summary"]
        rep.Save()
        comp.m_report_manager.AddReport(rep)
        LogInfo(f"[CAgentPDFProcessor] CFinancialReport实体构建并保存完成 {rep.GetReportName()}")
        return state

    def _node_mock_rag_ingest(self, state: CPdfProcessorState) -> CPdfProcessorState:
        LogInfo("[CAgentPDFProcessor] ===== MOCK RAG INGEST BEGIN =====")
        page_list = state["page_list"]
        mock_chunk_count = 0
        for idx in range(1, len(page_list)):
            pg = page_list[idx]
            mock_chunk_count += 1
            LogInfo(f"mock chunk page:{pg.m_page_num}, content_len:{len(pg.m_content)}")
        LogInfo(f"mock‑RAG 模拟完成，总模拟chunk数:{mock_chunk_count}")
        LogInfo("[CAgentPDFProcessor] ===== MOCK RAG INGEST END =====")
        return state

    def _node_finish(self, state: CPdfProcessorState) -> CPdfProcessorState:
        if state.get("is_skip", False):
            state["success"] = True
        return state

    def Run(self, pdf_file_path: str, force_overwrite: bool = False, dump_batch_summary: bool = False):
        init_state: CPdfProcessorState = {
            "pdf_path": pdf_file_path,
            "force_overwrite": force_overwrite,
            "dump_batch_summary": dump_batch_summary,
            "page_list": None,
            "total_page_count": 0,
            "has_got_meta": False,
            "company_short_name": None,
            "stock_code": None,
            "company_full_name": None,
            "company_desc": None,
            "report_type": None,
            "report_year": None,
            "report_date": None,
            "batch_summary_list": [],
            "report_dir": None,
            "full_report_summary": None,
            "akshare_style_text": None,
            "raw_full_text": None,
            "success": True,
            "is_skip": False,
            "fail_msg": None
        }
        LogInfo("CAgentPDFProcessor.Run")
        final_state = self.m_graph.invoke(init_state)
        return {
            "success": final_state["success"],
            "is_skip": final_state.get("is_skip", False),
            "fail_msg": final_state.get("fail_msg"),
            "report_dir": final_state.get("report_dir")
        }

